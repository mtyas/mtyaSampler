{
  "version": 3,
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (x64)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "vs2022-uidev",
      "displayName": "Visual Studio 2022 + UI dev server",
      "inherits": "vs2022",
      "binaryDir": "${sourceDir}/build-uidev",
      "cacheVariables": { "MTYA_UI_DEV_SERVER": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "vs2022", "configuration": "Debug" },
    { "name": "release", "configurePreset": "vs2022", "configuration": "Release" },
    { "name": "uidev", "configurePreset": "vs2022-uidev", "configuration": "Debug" }
  ]
}
